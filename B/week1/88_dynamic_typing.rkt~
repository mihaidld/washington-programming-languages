; Programming Languages, Dan Grossman
; Section 5: Dynamic Typing

#lang racket

(provide (all-defined-out))

; [second big difference from ML (and Java)] Dynamic Typing!!

; dynamic typing: can use values of any type anywhere
; alows flexible data structure without need to convince type checker it makes sense
; e.g., a list that holds numbers or other lists
; (list 1 (list 2 3 (list)) 4 (list 5))

(define xs (list  4 5 6))
(define ys (list (list 4 (list 5 0)) 6 7 (list 8) 9 2 3 (list 0 1)))

; this function sums lists of (numbers or lists of (numbers or ...)),
; but it does assume it only encounters lists or numbers (else run-time error)
(define (sum1 xs)
  (if (null? xs)
      0
      (if (number? (car xs))
          (+ (car xs) (sum1 (cdr xs)))
          (+ (sum1 (car xs)) (sum1 (cdr xs))))))

; this version does not fail on non-lists -- it treats them as 0
; if it find something which is not a number or a list, it skips it
; > (sum2 (list 1 "hi")) gives 1
(define (sum2 xs)
  (if (null? xs)
      0
      (if (number? (car xs))
          (+ (car xs) (sum2 (cdr xs)))
          (if (list? (car xs))
              (+ (sum2 (car xs)) (sum2 (cdr xs)))
              (sum2 (cdr xs))))))

; this version does not assume xs is list, just sums up numbers nested in xs or 0 for not-lists or not-numbers
(define (sum3 xs)
  (if (list? xs)
      (if (null? xs)
          0
          (+ (sum3 (car xs)) (sum3 (cdr xs))))
      (if (number? xs)
          xs
          0)))

