class Point
  attr_accessor :x, :y

  def initialize(x,y)
    @x = x
    @y = y
  end
  def distFromOrigin
    Math.sqrt(@x * @x  + @y * @y) # uses instance variables directly
  end
  def distFromOrigin2
    Math.sqrt(x * x + y * y) # uses getter methods
  end

end

# design question: "Is a 3D-point a 2D-point?" 
# [arguably poor style here, especially in statically typed OOP languages]

# inherit methods x,y,x=,y=, override initialize,distFromOrigin and
# distFromOrigin2 and add methods z,z=
class ThreeDPoint < Point
  attr_accessor :z

  def initialize(x,y,z) #override initialize of superclass
    super(x,y)
    @z = z
  end
  def distFromOrigin #override distFromOrigin
    d = super #get distance from x,y coordinates
    Math.sqrt(d * d + @z * @z)
  end
  def distFromOrigin2
    d = super
    Math.sqrt(d * d + z * z)
  end
end

# Polar point in 2D is not represented by x,y coordinates, but by a radius r
# distance from origin) and angle Theta in radians from point to positive x axis

#subclass overrides almost everything in superclass
#distFromOrigin2 inherited from parent class and not overriden uses in its body
#methods x and y (self.x and self.y, self being instance of subclass) which were
#overriden in subclass, here still works. Since inherited method calls in its
#body overriden methods it could have behaved differently from superclass
class PolarPoint < Point
  # Interesting: by not calling super constructor, no x and y instance vars
  # In Java/C#/Smalltalk would just have unused x and y fields since they are
  # not initialized, but in Ruby instances of PolarPoint don't have @x and @y
  def initialize(r,theta) #use different instance variables
    @r = r
    @theta = theta
  end

  #need to override x,y,x=,y=

  # to the client it looks like a getter method, though it's computing from r
  # and theta
  def x 
    @r * Math.cos(@theta)
  end
  def y
    @r * Math.sin(@theta)
  end
  def x= a
    b = y # avoids multiple calls to y method by storing in local var
    @theta = Math.atan2(b, a)
    @r = Math.sqrt(a*a + b*b)
    self
  end
  def y= b
    a = x # avoid multiple calls to x method
    @theta = Math.atan2(b, a)
    @r = Math.sqrt(a*a + b*b)
    self
  end
  def distFromOrigin # must override since inherited method does wrong thing
    @r
  end
  # inherited distFromOrigin2 already works (because uses methods x,y updated)!!
end

# the key example
pp = PolarPoint.new(4,Math::PI/4)
pp.x #sq rt of 8
pp.y #sq rt of 8
pp.distFromOrigin2

