class ColorPoint extends Point {...}

void m1(Point[] pt_arr){
    pt_arr[0] = new Point(3,4);//will throw exception because we try to assign
    //into an array of ColorPoint's a Point
}
String m2(int x){
    ColorPoint[] cpt_arr = new ColorPoint[x];// make array of ColorPoint's
    for(int i=0;i<x;i++){
	cpt_arr[i]= new ColorPoint(0,0,"green");
    }
    /* tries to mutate first element from type ColorPoint to supertype Point
       It type checks, but runtime error in m1 call named ArrayStoreException
       before getting missing color field on next line.
       if e1[e2]=e3 when we store into an array e1 at runtime, it checks
       run-time class of e1's elements (e.g. ColorPoint), run-time class of e3
       and do not allow storing a supertype (Point).
       Altough not caught  by type system, this avoids Java to be unsound */
    m1(cpt_arr);
    // never reach this
    return cpt_arr[0].color;
