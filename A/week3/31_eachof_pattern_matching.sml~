(* Programming Languages, Dan Grossman *)(* Section 2: Pattern-Matching for Each-Of Types:               The Truth About Function Arguments *)(* Every function in ML takes exactly 1 argument !!!Pattern matching works for one-of types to identify variant (constructor)and extract carried data, but also for each-of types *)(*pattern matching for tuples pattern (x1,..., xn) matches tuple value (v1,...,vn) so variable x1 will be bound to value v1(*1. Bad style*)since we add x, y and z they must have type int so function type is(int*int*int -> int *)fun sum_triple1 (triple : int * int * int) =    case triple of	(x,y,z) => z + y + x (* x,y,z are variables in 1 arm (one branch)			      * case expression (bad style) *)			     (*pattern matching for records pattern {field1=x1,..., fieldn=xn} matches record value {field1=v1,...,fieldn=vn} so variable x1 will be bound to value v1 *)fun full_name1 (r : {first:string,middle:string,last:string}) =    case r of	(* x,y,z are variables, pattern is binding to each variable	 * corresponding value for each field *)        {first=x,middle=y,last=z} => x ^ " " ^ y ^ " " ^z(* Val-binding patternsval variable_name = expression is just one kind ofval pattern = expressionwhere variable_name is bound to whole expression (variable matches againstthe entire result of evaluating expression), but it's possible toreplace variable_name by any pattern to extract pieces of aneach-of type expressionEach-of types need only one branch of case expressionone-of types nees multiple branches of case expression *)(* 2. Better style*)fun full_name2 (r : {first:string,middle:string,last:string}) =    let val {first=x,middle=y,last=z} = r    in	x ^ " " ^ y ^ " " ^z    end(*pattern match argument triple with val binding (x,y,z). triple will be evaluated by looking it up in dynamic environment, get its value and bind x,y,z to corresponding parts of triple. x,y, and z will be local variables in scope of let expressionType checker will make sure that triple is a tuple with 3 ints *)fun sum_triple2 triple =    let val (x,y,z) = triple     in         x + y + z     end(*Function-argument patterns A function argument can also be a pattern, not just a variable*  so we match against the argument in a function call.If argument is a variable it will be matched against the whole argument, butif the argument is a pattern, we'll extract pieces of the argument fun f pattern = expression *)	(* 3. Great style *)(*function must be passed an argument which matches pattern  {first=x,middle=y,last=z}, so only a record expression with fields first, middle and last. Since x, y and are concatenated, type checker requires given record fields values are strings*)fun full_name3 {first=x,middle=y,last=z} =    x ^ " " ^ y ^ " " ^z(*function takes 1 argument that will be pattern matched against tuple pattern (x,y,z) bing x, y and z to corresponding pieces of function call argument, then body used these variables*)			   fun sum_triple3 (x,y,z) =    x + y + z(*Since a function takes only 1 argument, multi-argument functions are just taking one tuple argument, implemented with a tuple pattern in the function binding.Multi-arguments is syntactic sugar for tuple 1-argument function. Zero arguments is the unit pattern () matching the unit value () e.g. fun hello() = print "Hello World\n"takes 1 argument of type unit*)		fun rotate_left (x,y,z) = (y,z,x)(*return multiple things from a function (a triple) and imemdiately pass them to another: because 3 int arguments or 1-argument tuple of 3 ints is same in ML *)fun rotate_right triple = rotate_left(rotate_left triple)